    {
      "slug": "sunflower-keys",
      "lane": 6,
      "name": "Sunflower Keys",
      "mode": "geometrydoor",
      "title": "Sunflower Keys \u2014 Let spokes and spiral tracing stay an optional visit",
      "depends": "nothing",
      "message": "angle and spiral exploration stays available without competing with planting and hearing a phrase",
      "groups": [
        {
          "id": "garden-geometry",
          "summary": "Look for spokes and spirals",
          "members": [
            ".angle-control"
          ]
        }
      ],
      "outside": [
        "#garden",
        "#sound-toggle",
        "#phrase-workbench"
      ],
      "copySelectors": [
        ".angle-control p:not(.trace-explainer)",
        ".trace-explainer"
      ],
      "steps": "Wrap the entire intact section.angle-control in closed details#garden-geometry at its existing location. Keep its existing aria-label, output, golden-reset button, range and both explanatory paragraphs and trace controls unchanged. Do not move it above the garden or phrase. Match max-width680px and centered width calc(100% - 32px). Scope any footer>section ancestry adjustments without restyling other shelves. No divergence, trace, seed geometry, drawing, sound or RAF changes.",
      "palette": "forest #071f1a, panel #103b2d, cream #f7efcf, border #4fa66f, gold #ffd166; existing Georgia/system fonts",
      "copy": [
        [
          ".angle-control p:not(.trace-explainer)",
          "At 137.5\u00b0, no spoke gets the next seed. Move away and spokes snap into view."
        ],
        [
          ".trace-explainer",
          "Neighboring seeds line up 34 and 55 steps apart \u2014 Fibonacci spirals hiding in the count."
        ]
      ]
    }
  ]
